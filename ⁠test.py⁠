import random
import time

print("🤖 أهلاً بك يا عبقري زمانك في أول اختبار بايثون حقيقي لك على الكلاود!")
time.sleep(1)
print("هل أنت مستعد لاختبار نسبة ذكائك، أم أن قوانين الفيزياء مسحت ما تبقى من خلايا مخك؟ 🤡")
time.sleep(2)

secret_number = random.randint(1, 10)
attempts = 3

print("\n🎯 لقد قمت باختيار رقم سري من 1 إلى 10.")
print("لديك 3 محاولات فقط لتعرفه، وإلا سأقوم بترحيلك للعمل في كول سنتر بـ 350 دينار! 📞🗑️")

while attempts > 0:
    try:
        guess = int(input(f"\nباقي لك {attempts} محاولات... أدخل رقمك يا مهندس: "))
    except ValueError:
        print("يا هبيلة قلت لك أدخل رقماً، مش أحرف! 🤦‍♂️ رح تخرب الكود، ركز وخلي إيدك خفيفة ع السويتشات الزرقا!")
        continue

    if guess == secret_number:
        print(f"\n🎉 واو! مستحيل! لقد عرفت الرقم ({secret_number})!")
        print("يبدو أن الجلوس تحت شجرة الدراجون فروت أتى بثماره أخيراً! 🐉🌳😎 طريق الجامعة الهاشمية بانتظارك!")
        break
    elif guess < secret_number:
        print("غلط يا فلتة! الرقم السري أكبر من هيك. شغل مخك شوي! 📈")
    else:
        print("طرت بالعالي يا نيوتن! الرقم السري أصغر من هيك. انزل عالأرض! 📉")

    attempts -= 1

if attempts == 0 and guess != secret_number:
    print(f"\n💀 انتهت محاولاتك! الرقم السري كان {secret_number}.")
    print("للأسف، أثبتت فشلك الذريع. اذهب فوراً وتدرب على جملة: طفي الراوتر وارجع شغله يا فندم! 📞🤡🗑️")
